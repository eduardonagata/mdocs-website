---
import HeroTypeset from '../react/hero/HeroTypeset';
import { site } from '../data/site';
---

<section class="hero" id="topo">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="container">
    <div class="intro">
      <p class="label label--plain eyebrow">
        <span class="dot" aria-hidden="true"></span>
        Máquina tipográfica · macOS e iOS
      </p>
      <h1 class="display">
        A IA escreve em markdown.
        <span class="paper-voice">Seus documentos saem em A4, com papel timbrado.</span>
      </h1>
      <p class="lead">
        Documentos formais exigem margens, tipografia e timbre — e a IA só entrega texto com
        <code>#</code> e <code>**</code>. O MarkDocs é a peça que faltava entre os dois: você conversa com o
        agente, e cada título, parágrafo e lista é composto num PDF preciso, exatamente como você configurou.
      </p>
      <div class="ctas">
        <a class="btn btn--primary" href={site.downloadUrl}>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"
            ><path
              d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 14.5v1A1.5 1.5 0 0 0 5.5 17h9a1.5 1.5 0 0 0 1.5-1.5v-1"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          Baixar para Mac
        </a>
        <a class="btn btn--ghost" href="#demonstracao">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"
            ><circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.5"></circle><path
              d="M8.5 7.4v5.2l4.2-2.6-4.2-2.6Z"
              fill="currentColor"></path></svg
          >
          Ver demonstração
        </a>
      </div>
      <p class="fine">
        {site.trialDays} dias grátis · Licença perpétua · Traga sua própria chave de IA
      </p>
    </div>

    <div class="machine reveal">
      <HeroTypeset client:visible />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(72px, 9vw, 140px);
    overflow: clip;
  }

  /* Grade pontilhada de diagramação, esmaecendo nas bordas */
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(22 24 27 / 0.13) 0.8px, transparent 0.8px);
    background-size: 24px 24px;
    background-position: -12px -12px;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 42%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 42%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  .intro {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-5);
    max-width: 980px;
    margin-inline: auto;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 12px;
    border-radius: var(--radius-pill);
    background: rgb(253 252 249 / 0.7);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--metal-gradient);
    box-shadow: 0 0 0 0.5px rgb(22 24 27 / 0.25);
  }

  h1 {
    margin-top: var(--space-2);
  }

  h1 .paper-voice {
    display: block;
    color: var(--ink-2);
    margin-top: 0.08em;
  }

  .lead {
    max-width: 660px;
  }

  .lead code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 0.08em 0.38em;
    border-radius: 5px;
    background: rgb(22 24 27 / 0.06);
    color: var(--ink-1);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .fine {
    font-size: var(--text-small);
    color: var(--ink-3);
  }

  .machine {
    position: relative;
    margin-top: clamp(48px, 5.5vw, 76px);
  }
</style>
